# init.svc.* properties are private to the system init domain. Keep this
# lifecycle trigger in the first-stage ramdisk while the service definitions
# remain in /vendor/etc/init/hw/init.angler.rc.
on post-fs-data
    # /data/misc/radio is a core-owned path.  Creating these QCRIL flags from
    # vendor_init is rejected by Android 15 SELinux before the modem cold boot.
    mkdir /data/misc/radio 0770 system radio
    write /data/misc/radio/copy_complete 0
    chown radio radio /data/misc/radio/copy_complete
    chmod 0660 /data/misc/radio/copy_complete
    write /data/misc/radio/prebuilt_db_support 1
    chown radio radio /data/misc/radio/prebuilt_db_support
    chmod 0400 /data/misc/radio/prebuilt_db_support
    write /data/misc/radio/db_check_done 0
    chown radio radio /data/misc/radio/db_check_done
    chmod 0660 /data/misc/radio/db_check_done

on property:init.svc.per_mgr=running
    start per_proxy
