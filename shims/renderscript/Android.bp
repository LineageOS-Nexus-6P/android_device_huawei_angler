    name: "librs_legacy_math_shim",
    vendor: true,
    compile_multilib: "32",
    srcs: ["RenderScriptLegacyMath.cpp"],
    shared_libs: ["libm"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
