    name: "libaudioclient_legacy_shim",
    vendor: true,
    compile_multilib: "64",
    srcs: ["AudioSystemLegacy.cpp"],
    shared_libs: ["libaudioclient"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
