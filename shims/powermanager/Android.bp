cc_library_shared {
    name: "libpowermanager_legacy_shim",
    vendor: true,
    compile_multilib: "both",
    srcs: ["PowerManagerLegacy.cpp"],
    shared_libs: [
        "libbinder",
        "libpowermanager",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
