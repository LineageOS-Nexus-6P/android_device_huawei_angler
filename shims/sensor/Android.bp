cc_library_shared {
    name: "libsensor_eventqueue_legacy_shim",
    vendor: true,
    compile_multilib: "both",
    srcs: ["SensorManagerLegacy.cpp"],
    shared_libs: [
        "libsensor",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
