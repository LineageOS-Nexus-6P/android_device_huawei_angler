# The PIL firmware fallback is handled by ueventd on the stock Angler kernel.
# It must be able to copy modem.mdt and the modem firmware segments from the
# read-only /firmware mount into the kernel firmware-loading interface.
allow ueventd firmware_file:dir r_dir_perms;
allow ueventd firmware_file:file r_file_perms;

# Apply the system-owned modes from ueventd.angler.rc to the FPC1020 controls.
allow ueventd sysfs_angler_fingerprint:dir r_dir_perms;
allow ueventd sysfs_angler_fingerprint:file rw_file_perms;
