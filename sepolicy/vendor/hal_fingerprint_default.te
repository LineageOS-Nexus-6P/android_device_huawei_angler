# The stock FPC HAL communicates with its secure application over QSEECom.
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file ioctl;
r_dir_file(hal_fingerprint_default, firmware_file)

# Fingerprint navigation and the FPC1020 interrupt/control interface.
allow hal_fingerprint_default input_device:dir r_dir_perms;
allow hal_fingerprint_default input_device:chr_file { read open getattr ioctl };
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;
allow hal_fingerprint_default sysfs_angler_fingerprint:dir r_dir_perms;
allow hal_fingerprint_default sysfs_angler_fingerprint:file rw_file_perms;

# The stock HAL probes power-supply state through the BCL sysfs parent.
allow hal_fingerprint_default sysfs_thermal:dir search;
