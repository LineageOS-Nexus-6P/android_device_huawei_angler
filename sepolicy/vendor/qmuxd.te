type qmuxd, domain;
type qmuxd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(qmuxd)
net_domain(qmuxd)

angler_qmux_socket(qmuxd)
wakelock_use(qmuxd)
get_prop(qmuxd, angler_radio_legacy_prop)

allow qmuxd radio_device:chr_file rw_file_perms;
allow qmuxd shared_log_device:chr_file rw_file_perms;
allow qmuxd sysfs_smd_open_timeout:file rw_file_perms;
allow qmuxd sysfs_msm_subsys:dir r_dir_perms;
allow qmuxd sysfs_msm_subsys:lnk_file r_file_perms;
allow qmuxd sysfs_msm_subsys:file r_file_perms;
allow qmuxd sysfs_angler_socinfo:dir r_dir_perms;
allow qmuxd sysfs_angler_socinfo:file r_file_perms;
allow qmuxd self:capability { setgid setpcap setuid };
allow qmuxd self:socket create_socket_perms_no_ioctl;

userdebug_or_eng(`
    allow qmuxd diag_device:chr_file rw_file_perms;
')
