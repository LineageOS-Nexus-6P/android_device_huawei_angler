# The stock QCRIL v12 client uses Qualcomm's qmuxd Unix socket transport.
angler_qmux_socket(rild)
binder_use(rild)
binder_call(rild, per_mgr)
binder_call(rild, audioserver)
allow rild per_mgr_service:service_manager find;
allow rild audioserver_service:service_manager find;
set_prop(rild, angler_radio_legacy_prop)

# The stock QCRIL database predates /data/vendor. Keep this compatibility
# exception confined to rild and the existing /data/misc/radio label.
typeattribute rild data_between_core_and_vendor_violators;

allow rild self:socket ioctl;
allowxperm rild self:socket ioctl msm_sock_ipc_ioctls;
allow rild vendor_file:file lock;
allow rild system_data_file:dir { getattr search };
allow rild radio_core_data_file:dir rw_dir_perms;
allow rild radio_core_data_file:file create_file_perms;
allow rild sysfs_msm_subsys:dir r_dir_perms;
allow rild sysfs_msm_subsys:lnk_file r_file_perms;
allow rild sysfs_msm_subsys:file r_file_perms;

userdebug_or_eng(`
    allow rild diag_device:chr_file rw_file_perms;
')
