allow hal_power_default angler_perfd_data_file:dir search;
allow hal_power_default angler_perfd_data_file:sock_file write;
allow hal_power_default angler_perfd:unix_stream_socket connectto;

# Short interaction-only Adreno floor used to keep notification-card rendering
# inside the frame budget. Thermal control retains ownership of the max clock.
allow hal_power_default sysfs:dir r_dir_perms;
allow hal_power_default sysfs:lnk_file r_file_perms;
allow hal_power_default sysfs_angler_power:file rw_file_perms;
