type angler_radio_init, domain;
type angler_radio_init_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(angler_radio_init)
typeattribute angler_radio_init data_between_core_and_vendor_violators;

allow angler_radio_init vendor_shell_exec:file rx_file_perms;
allow angler_radio_init vendor_toolbox_exec:file rx_file_perms;
allow angler_radio_init vendor_file:dir r_dir_perms;
allow angler_radio_init vendor_file:file r_file_perms;
allow angler_radio_init firmware_file:dir r_dir_perms;
allow angler_radio_init firmware_file:file r_file_perms;
allow angler_radio_init firmware_file:lnk_file r_file_perms;
allow angler_radio_init radio_core_data_file:dir rw_dir_perms;
allow angler_radio_init radio_core_data_file:dir create_dir_perms;
allow angler_radio_init radio_core_data_file:file create_file_perms;

# IPC Router security must complete before qmuxd opens the modem control
# channels.  Keep the tiny one-shot isolated from vendor_init.
type irsc_util, domain;
type irsc_util_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(irsc_util)

allow irsc_util self:socket { create ioctl };
allowxperm irsc_util self:socket ioctl msm_sock_ipc_ioctls;
allow irsc_util vendor_configs_file:file r_file_perms;
