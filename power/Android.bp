// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "android.hardware.power-service.angler",
    defaults: ["android.hardware.power-ndk_shared"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.power-service.angler.rc"],
    vintf_fragments: ["android.hardware.power-service.angler.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libdl",
    ],
    srcs: [
        "main.cpp",
        "Power.cpp",
    ],
}

cc_test {
    name: "angler_power_integration_test",
    defaults: ["android.hardware.power-ndk_shared"],
    vendor: true,
    srcs: [
        "tests/PowerIntegrationTest.cpp",
        "Power.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libdl",
    ],
}
